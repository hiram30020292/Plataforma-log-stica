{
  "name": "MCL - Corregidora Móvil Logistics",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "pip install -e '.[dev]'",
  "postAttachCommand": {
    "servidor": "python -m uvicorn mcl.api:create_app --factory --reload --host 0.0.0.0 --port 8000"
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "MCL",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    }
  }
}
