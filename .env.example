# Copia este archivo como .env y completa los valores.
# El archivo .env nunca se sube al repositorio.

# Entorno: development | testing | production
MCL_ENVIRONMENT=development
MCL_DEBUG=false

# Base de datos. SQLite en desarrollo; en producción, PostgreSQL, por ejemplo:
# MCL_DATABASE_URL=postgresql://usuario:clave@servidor:5432/mcl
MCL_DATABASE_URL=sqlite:///./mcl.db

# Avisos por correo con Gmail. Usa una "contraseña de aplicación" de Google
# (Cuenta de Google > Seguridad > Verificación en 2 pasos > Contraseñas de aplicaciones),
# no la contraseña normal de la cuenta. Define las dos variables o ninguna.
# MCL_SMTP_USER=tu-cuenta@gmail.com
# MCL_SMTP_PASSWORD=
# MCL_SMTP_HOST=smtp.gmail.com
# MCL_SMTP_PORT=587
